import time
import numpy as np
import matplotlib.pyplot as plt
from scipy.io import wavfile

start = time.time()
filename = "/Users/rma/Documents/lab2/33.wav"

# Чтение файла
try:
    rate, data = wavfile.read(filename)
except:
    print("Ошибка чтения файла")
    exit()

if data.ndim > 1:
    data = data[:, 0]  # берём первый канал

print(f"Частота: {rate} Гц, Отсчётов: {len(data)}")

# Ввод количества отсчётов
while True:
    try:
        n = int(input(f"Отсчётов (1..{len(data)}): "))
        if 1 <= n <= len(data):
            break
    except:
        print("Введите число")

# 1. График первых n отсчётов (линия с маркерами '*')
plt.figure(1)
plt.plot(range(n), data[:n], marker='*', linestyle='-', markersize=3)
plt.title(f"Первые {n} отсчётов")
plt.xlabel("Номер отсчёта")
plt.ylabel("Амплитуда")
plt.grid()

# 2. Осциллограмма всего сигнала
t = np.arange(len(data)) / rate
plt.figure(2)
plt.plot(t, data)
plt.title("Осциллограмма")
plt.xlabel("Время, с")
plt.ylabel("Амплитуда")
plt.grid()

# 3. Спектр (мнимая часть ДПФ)
fft_imag = np.imag(np.fft.fft(data.astype(float)))
freq = np.fft.fftfreq(len(data), 1/rate)
plt.figure(3)
plt.plot(freq[freq >= 0], fft_imag[freq >= 0])
plt.title("Мнимая часть ДПФ")
plt.xlabel("Частота, Гц")
plt.ylabel("Im(ДПФ)")
plt.grid()

# 4. Гистограмма амплитуд
plt.figure(4)
plt.hist(data, bins='auto', edgecolor='black')
plt.title("Гистограмма амплитуд")
plt.xlabel("Амплитуда")
plt.ylabel("Количество отсчётов")
plt.grid()

plt.show()
print(f"Время: {time.time() - start:.3f} с")
